<div class="card mb-5">
    <header class="card-header is-series">
        <p class="card-header-title has-text-link-dark is-size-6">
            <span class="icon mr-2"><i class="fa fa-solid fa-layer-group"></i></span>
            Available Series
        </p>
    </header>
    <div class="card-content pt-4 pb-4">
        @for (int i = 0; i < SeriesList.Count; ++i)
        {
            int temp = i;
            <label class="panel-block @(SeriesList.IndexOf(SelectedSeries) == temp ? "is-active" : "")">
                <input type="radio" name="selectedSeries" value="@SeriesList[temp].Guid"
                       checked="@(SeriesList.IndexOf(SelectedSeries) == temp)"
                       @onchange="@(() => SelectedSeries = SeriesList[temp])">

                <span class="ml-2 @(SeriesList.IndexOf(SelectedSeries) == temp ? "has-text-weight-semibold" : "")">
                    <input type="text" @bind=@SeriesList[temp].Label @bind:event="oninput" />
                </span>
                
                <span class="delete-btn" @onclick="@(() => RemoveSeries(SeriesList[temp].Guid))">
                    <i class="fa fa-solid fa-trash"></i>
                </span>
            </label>
        }       
    </div>
</div>