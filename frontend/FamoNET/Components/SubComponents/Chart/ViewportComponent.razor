<div class="card">
    <header class="card-header is-view">
        <p class="card-header-title has-text-grey-dark is-size-6">
            <span class="icon mr-2"><i class="fa fa-solid fa-desktop"></i></span>
            Viewport Settings
        </p>
    </header>
        <div class="field mb-4">
            <label class="label is-small">Mode</label>
            <div class="field has-addons">
                <div class="select">
                    <select @bind=AxisMode>
                        <option value="@Model.AxisMode.Mjd">MJD</option>
                        <option value="@Model.AxisMode.Date">Date</option>                        
                    </select>
                </div>
            </div>
        </div>
    @if(AxisMode == Model.AxisMode.Mjd)
    {
        <MjdViewportComponent ChartGuid="ChartGuid" />
    }
    else
    {
        <DateViewportComponent ChartGuid="ChartGuid" />
    }
</div>