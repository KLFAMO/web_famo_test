<div class="card">
    <header class="card-header is-view">
        <p class="card-header-title has-text-grey-dark is-size-6">
            <span class="icon mr-2"><i class="fa fa-solid fa-desktop"></i></span>
            Viewport Settings
        </p>
    </header>
    <div class="field m-5">
        <label class="label is-small">Mode</label>
        <div class="field has-addons">
            <div class="select">
                <select @bind=AxisMode @bind:after=OnAxisModeChange>
                    <option value="@Model.AxisMode.Mjd">MJD</option>
                    <option value="@Model.AxisMode.Date">Date</option>
                    <option value="@Model.AxisMode.Seconds">Seconds</option>
                </select>
            </div>
        </div>
    </div>
    <div style="display: @(AxisMode == Model.AxisMode.Mjd ? "block" : "none")">
        <MjdViewportComponent @ref=MjdViewportComponent ChartGuid="ChartGuid" />
    </div>
    <div style="display: @(AxisMode == Model.AxisMode.Date ? "block" : "none")">
        <DateViewportComponent @ref=DateViewportComponent ChartGuid="ChartGuid" />
    </div>
    <div style="display: @(AxisMode == Model.AxisMode.Seconds ? "block" : "none")">
        <SecondsViewportComponent @ref=SecondsViewportComponent ChartGuid="ChartGuid" @bind-ZeroPointMjd=ZeroPointMjd @bind-ZeroPointMjd:after=OnZeroPointMjdChanged />
    </div>

</div>