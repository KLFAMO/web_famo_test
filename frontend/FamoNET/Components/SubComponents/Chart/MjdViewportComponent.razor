@using FamoNET.Model
@inherits ViewportComponentBase


@if (MjdViewportParams != null)
{
    <div class="card-content pt-4 pb-4">
        <div class="field mb-3">
            <label class="label is-small">Chart Title</label>
            <div class="control">
                <input class="input is-small" type="text" @bind=Title>
            </div>
        </div>

        <div class="field mb-2">
            <label class="label is-small">X-Axis Range</label>
            <div class="field has-addons">
                <p class="control"><InputNumber class="input is-small range-input" placeholder="Min" @bind-Value=MjdViewportParams.MinX /></p>
                <p class="control"><a class="button is-static is-small">-</a></p>
                <p class="control"><InputNumber class="input is-small range-input" placeholder="Max" @bind-Value=MjdViewportParams.MaxX /></p>
            </div>
        </div>

        <div class="field mb-4">
            <label class="label is-small">Y-Axis Range</label>
            <div class="field has-addons">
                <p class="control"><InputNumber class="input is-small range-input" placeholder="Min" @bind-Value=MjdViewportParams.MinY /></p>
                <p class="control"><a class="button is-static is-small">-</a></p>
                <p class="control"><InputNumber class="input is-small range-input" placeholder="Max" @bind-Value=MjdViewportParams.MaxY /></p>
            </div>
        </div>        

        <button class="button is-small is-fullwidth" @onclick=@(() => ApplyParameters())>
            Update View
        </button>

    </div>
}
