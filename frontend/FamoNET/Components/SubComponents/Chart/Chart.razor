@rendermode InteractiveServer
@inherits ChartWithAllanComponentBase<double>

@if(IsEditable)
{
    <div class="box">
        <div class="columns">
            <div class="column">
                <SeriesListComponent @ref=SeriesListComponent @bind-SelectedSeries=SelectedSeries @bind-SelectedSeries:after=SendToAllan SeriesAdded=Redraw SeriesDeleted=Redraw />
            </div>
            <div class="column">
                <MathComponent @bind-Series="SelectedSeries" @bind-Series:after=Redraw />
            </div>
            <div class="column">
                <ViewportComponent @ref=ViewportComponent ChartGuid="ChartGuid" AxisModeChanged="OnAxisModeChanged" ZeroPointMjdChanged="OnZeroPointMjdChanged" />
            </div>
        </div>
    </div>
}

<div class="level">
    <div class="level-left">
        @if(IsEditable)
        {
            <button class="button" type="button" @onclick=@((e) => ChartManagerService.AdjustToVisible(ChartGuid))>Adjust to visible</button>
        }
        
        <button class="button" type="button" @onclick=SaveToFile>Save to file</button>
    </div>
</div>
<div style="display: @(IsDataLoading ? "block" : "none")">
    <progress class="progress is-small is-primary" max="100">15%</progress>
</div>

<div id="@ChartGuid" style="width: 100%; height: 600px" @oncontextmenu:preventDefault="true" @oncontextmenu="OnChartClick"></div>

@if (EnableAllan)
{
    <div class="box">
        <AllanVariance @ref="AllanVariance" @key=ChartGuid />
    </div>
}
