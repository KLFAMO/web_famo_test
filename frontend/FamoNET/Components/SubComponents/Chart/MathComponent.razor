<div class="card mb-5">
    <header class="card-header is-math">
        <p class="card-header-title has-text-link-dark is-size-6">
            <span class="icon mr-2 has-text-primary-dark"><i class="fa fa-solid fa-calculator"></i></span>
            Math
        </p>
    </header>
    <div class="card-content pt-4 pb-4">
        @if (_lastSeries == null)
        {
            <p class="help mb-3 is-italic" id="mathTargetLabel"><strong>Select data series</strong></p>
        }
        else
        {
            <p class="help mb-3 is-italic" id="mathTargetLabel">Target: <strong>@_lastSeries.Label</strong></p>

            <div class="field mb-2">
                <div class="field has-addons">
                    <p class="control"><a class="button is-static is-small math-label">x' =</a></p>
                    <p class="control is-expanded">
                        <input class="input is-small is-formula" type="text" placeholder="empty (no change)" @bind=@_lastSeries.MathExpressionX @bind:event="oninput">
                    </p>
                </div>
            </div>

            <div class="field mb-3">
                <div class="field has-addons">
                    <p class="control"><a class="button is-static is-small math-label">y' =</a></p>
                    <p class="control is-expanded">
                        <input class="input is-small is-formula" type="text" placeholder="y * 10" @bind=@_lastSeries.MathExpressionY @bind:event="oninput">
                    </p>
                </div>
            </div>

            <button class="button is-primary is-small is-fullwidth is-light" type="button" @onclick=ApplyMath>
                Apply Transformation
            </button>
            @if (IsCalculating)
            {
                <progress class="progress is-small is-primary" max="100">15%</progress>
            }
        }        
    </div>
    
</div>