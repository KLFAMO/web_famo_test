@rendermode InteractiveServer
@inherits ChartWithAllanComponentBase<double>


<div class="box">
    <div class="columns">
        <div class="column">
            <SeriesListComponent @ref=SeriesListComponent @bind-SelectedSeries=SelectedSeries @bind-SelectedSeries:after=Redraw />
        </div>
        <div class="column">
            <MathComponent @bind-Series="SelectedSeries" @bind-Series:after=Redraw />
        </div>
        <div class="column">
            <ViewportComponent @ref=ViewportComponent ChartGuid="ChartGuid" AxisModeChanged="OnAxisModeChanged" />
        </div>
    </div>    
</div>

<div class="level">
    <div class="level-left">
        <button class="button" type="button">Adjust to visible</button>
        <button class="button" type="button">Save to file</button>
    </div>
</div>

<div id="@ChartGuid" style="width: 100%; height: 600px" @oncontextmenu:preventDefault="true" @oncontextmenu="OnChartClick"></div>

@if (EnableAllan)
{
    <div class="box">
        <AllanVariance @ref="AllanVariance" @key=ChartGuid />
    </div>
}
