@page "/live"

<div class="box">
    <EditForm Model="this" OnSubmit="@StartLive">
        <div class="field has-addons">
            <p class="control">
                <a class="button is-static">
                    Table
                </a>
            </p>
            <p class="control">
                <div class="select">
                    <select aria-label="Choose data" @bind="@_selectedTableName">
                        <option selected>Choose data</option>
                        @foreach (var tableName in TableNames)
                        {
                            <option value="@tableName">@tableName</option>
                        }
                    </select>
                </div>
            </p>
        </div>
        <div class="field has-addons">
            <p class="control">
                <a class="button is-static">
                    Points count
                </a>
            </p>
            <p class="control">
                <InputNumber class="input" @bind-Value="@_points" placeholder="Count" id="title" required />
            </p>            
        </div>
        <div class="field">
            <button type="submit" class="button is-primary">Live</button>
        </div>
    </EditForm>

    
    <FamoNET.Components.SubComponents.Chart.LiveChart @ref=LiveChart Points="Points" TableNameParam="SelectedTableName" EnableAllan=true />       
</div>