@page "/charts"
@using FamoNET.Components.SubComponents
@rendermode InteractiveServer

@foreach(var chartPair in LoadedCharts)
{    
    <SpectrumAnalyzerChart @key=chartPair.Key ComponentGuid=chartPair.Key ChartCloseRequested="OnChartClose"></SpectrumAnalyzerChart>
}

<div class="container has-text-centered">
    <button type="button" class="button" @onclick="AddChart">Add chart</button>
</div>

<SystemMessageComponent @ref="SystemMessageComponent"></SystemMessageComponent>
<FamoNET.Components.SubComponents.Wizards.FileWizard @ref=FileWizard></FamoNET.Components.SubComponents.Wizards.FileWizard>