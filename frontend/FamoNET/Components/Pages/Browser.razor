@page "/browser"
@using FamoNET.Components.SubComponents
@using FamoNET.Components.SubComponents.Chart
@rendermode InteractiveServer


<div class="block">
    <div class="container">    
        <DataWizard @ref="DataFetchWizardComponent" />                
    </div>
</div>


@if (IsFetchingData)
{
    <progress class="progress is-large is-info" max="100">60%</progress>
}

<div class="block" style="visibility: @(IsDataLoaded ? "visible" : "hidden")">   
    <Chart_MJD @ref="Chart_MJD" />        
</div>
 
<SystemMessageComponent></SystemMessageComponent>