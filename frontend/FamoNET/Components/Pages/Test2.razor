@page "/test2"
<div class="box">
    <div class="columns">
        <div class="column">
            <div class="card mb-5">
                <header class="card-header is-math">
                    <p class="card-header-title has-text-link-dark is-size-6">
                        <span class="icon mr-2"><i class="fa fa-solid fa-layer-group"></i></span>
                        Available Series
                    </p>
                </header>
                <div class="card-content pt-4 pb-4">

                    <label class="panel-block is-active">
                        <input type="radio" name="selectedSeries" value="0" checked onchange="selectSeries(0)">
                        <span class="ml-2 has-text-weight-semibold">TELESCOPE_LOG_2023</span>
                        <span class="delete-btn" title="Remove Series" onclick="deleteSeries(0)">
                            <i class="fa fa-solid fa-trash"></i>
                        </span>
                    </label>

                    <label class="panel-block">
                        <input type="radio" name="selectedSeries" value="1" onchange="selectSeries(1)">
                        <span class="ml-2">SENSOR_MAIN_01</span>
                        <span class="delete-btn" title="Remove Series" onclick="deleteSeries(1)">
                            <i class="fa-solid fa-trash-can"></i>
                        </span>
                    </label>

                    <label class="panel-block">
                        <input type="radio" name="selectedSeries" value="2" onchange="selectSeries(2)">
                        <span class="ml-2">WEATHER_AUX</span>
                        <span class="delete-btn" title="Remove Series" onclick="deleteSeries(2)">
                            <i class="fa-solid fa-trash-can"></i>
                        </span>
                    </label>
                </div>
            </div>
        </div>
        <div class="column">
            <div class="card mb-5">
                <header class="card-header is-math">
                    <p class="card-header-title has-text-link-dark is-size-6">
                        <span class="icon mr-2 has-text-primary-dark"><i class="fa fa-solid fa-calculator"></i></span>
                        Transform Selection
                    </p>
                </header>
                <div class="card-content pt-4 pb-4">

                    <p class="help mb-3 is-italic" id="mathTargetLabel">Target: <strong>TELESCOPE_LOG_2023</strong></p>

                    <div class="field mb-2">
                        <div class="field has-addons">
                            <p class="control"><a class="button is-static is-small math-label">x' =</a></p>
                            <p class="control is-expanded">
                                <input class="input is-small is-formula" type="text" placeholder="x (no change)">
                            </p>
                        </div>
                    </div>

                    <div class="field mb-3">
                        <div class="field has-addons">
                            <p class="control"><a class="button is-static is-small math-label">y' =</a></p>
                            <p class="control is-expanded">
                                <input class="input is-small is-formula" type="text" placeholder="y * 10">
                            </p>
                        </div>
                    </div>

                    <button class="button is-primary is-small is-fullwidth is-light">
                        Apply Transformation
                    </button>
                </div>
            </div>
        </div>

        <div class="column">
            <div class="card">
                <header class="card-header is-view">
                    <p class="card-header-title has-text-grey-dark is-size-6">
                        <span class="icon mr-2"><i class="fa fa-solid fa-desktop"></i></span>
                        Viewport Settings
                    </p>
                </header>
                <div class="card-content pt-4 pb-4">

                    <div class="field mb-3">
                        <label class="label is-small">Chart Title</label>
                        <div class="control">
                            <input class="input is-small" type="text" value="Data Overview">
                        </div>
                    </div>

                    <div class="field mb-2">
                        <label class="label is-small">X-Axis Range</label>
                        <div class="field has-addons">
                            <p class="control"><input class="input is-small range-input" placeholder="Min"></p>
                            <p class="control"><a class="button is-static is-small">-</a></p>
                            <p class="control"><input class="input is-small range-input" placeholder="Max"></p>
                        </div>
                    </div>

                    <div class="field mb-4">
                        <label class="label is-small">Y-Axis Range</label>
                        <div class="field has-addons">
                            <p class="control"><input class="input is-small range-input" placeholder="Min"></p>
                            <p class="control"><a class="button is-static is-small">-</a></p>
                            <p class="control"><input class="input is-small range-input" placeholder="Max"></p>
                        </div>
                    </div>

                    <button class="button is-small is-fullwidth">
                        Update View
                    </button>

                </div>
            </div>
        </div>
    </div>
</div>
<div class="level">
    <div class="level-left">
        <button class="button" type="button">Adjust to visible</button>
        <button class="button" type="button">Save to file</button>
    </div>            
</div>
<div class="box" style="height: 600px; display: flex; align-items: center; justify-content: center; background-color: white;">
    <p class="has-text-grey-light is-size-4">Chart Canvas Area</p>
</div>
<div class="box" style="height: 300px; display: flex; align-items: center; justify-content: center; background-color: white;">
    <p class="has-text-grey-light is-size-4">Allan Canvas Area</p>
</div>
